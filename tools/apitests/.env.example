# Copy to tools/apitests/.env and fill in. This file is git-ignored.

# --- YouTube Music -------------------------------------------------------
# Full Cookie header from a signed-in music.youtube.com request.
# DevTools > Network > any /youtubei/v1/ request > Request Headers > Cookie.
# Must contain SAPISID (or __Secure-3PAPISID) for authenticated calls to work.
YTM_COOKIE=

# Optional. From the same request payload: context.user.onBehalfOfUser.
# Only needed when the Google account has multiple YouTube channels/brand accounts.
YTM_DATA_SYNC_ID=

# --- Spotify -------------------------------------------------------------
# Your own Spotify app's client id (https://developer.spotify.com/dashboard).
# Add http://127.0.0.1:8888/callback to the app's Redirect URIs.
# No client secret is used anywhere: the flow is Authorization Code + PKCE.
SPOTIFY_CLIENT_ID=
SPOTIFY_CALLBACK_PORT=8888

# Optional: paste a short-lived token instead of running spotify_login.py.
SPOTIFY_ACCESS_TOKEN=
